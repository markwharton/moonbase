{
  "$schema": "https://plankit.com/pk.schema.json",
  "changelog": {
    "hooks": {
      "postVersion": "node tools/package-versions.mjs \"$VERSION\"",
      "preCommit": "git add packages/mos6502/package.json packages/charset/package.json packages/files/package.json packages/c64/package.json packages/apple2e/package.json packages/vector/package.json"
    },
    "types": [
      {
        "section": "Added",
        "type": "feat"
      },
      {
        "section": "Fixed",
        "type": "fix"
      },
      {
        "section": "Deprecated",
        "type": "deprecate"
      },
      {
        "section": "Removed",
        "type": "revert"
      },
      {
        "section": "Security",
        "type": "security"
      },
      {
        "section": "Changed",
        "type": "refactor"
      },
      {
        "section": "Changed",
        "type": "perf"
      },
      {
        "section": "Documentation",
        "type": "docs"
      },
      {
        "section": "Maintenance",
        "type": "chore"
      },
      {
        "section": "Maintenance",
        "type": "test"
      },
      {
        "section": "Maintenance",
        "type": "build"
      },
      {
        "section": "Maintenance",
        "type": "ci"
      },
      {
        "section": "Maintenance",
        "type": "style"
      },
      {
        "hidden": true,
        "section": "Plans",
        "type": "plan"
      }
    ],
    "versionFiles": [
      {
        "path": "package.json",
        "type": "json"
      },
      {
        "path": "packages/mos6502/package.json",
        "type": "json"
      },
      {
        "path": "packages/charset/package.json",
        "type": "json"
      },
      {
        "path": "packages/files/package.json",
        "type": "json"
      },
      {
        "path": "packages/c64/package.json",
        "type": "json"
      },
      {
        "path": "packages/apple2e/package.json",
        "type": "json"
      },
      {
        "path": "packages/vector/package.json",
        "type": "json"
      }
    ]
  },
  "guard": {
    "branches": [
      "main"
    ],
    "breaking": "ask",
    "mode": "block",
    "push": "block"
  },
  "preserve": {
    "dir": "docs/plans",
    "mode": "manual"
  },
  "release": {
    "branch": "main",
    "hooks": {}
  }
}
