{
  "name": "@moonbase-machines/player",
  "version": "0.9.1",
  "description": "The player for Mark Wharton's titles of 1985 to 1995: the Original, a game's own disk on Moonbase's machines, and the Remake, its scenes on an engine; the player's own disk of saves in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Mark Wharton",
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "bin": {
    "moonbase-compile": "./bin/moonbase-compile.mjs",
    "moonbase-play": "./bin/moonbase-play.mjs"
  },
  "dependencies": {
    "@moonbase-machines/apple2e": "0.9.1",
    "@moonbase-machines/c64": "0.9.1",
    "@moonbase-machines/charset": "0.9.1",
    "@moonbase-machines/mos6502": "0.9.1",
    "@moonbase-machines/vector": "0.9.1"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepack": "node ../../tools/package-files.mjs player"
  }
}
